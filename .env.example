# Optional deployment configuration.
# SPARROW_DEPLOYMENTS=conf/deployment.json

# Optional server port.
# PORT=8080

# PostgreSQL URLs must include sslmode=require
# or an appropriate stronger TLS verification mode.

# Direct connection, also used as runtime fallback.
DATABASE_URL=

# Preferred runtime connection for the web application.
DATABASE_URL_POOLED=

# Preferred direct connection for the seed command.
DATABASE_URL_DIRECT=

# Explicitly enable read-only Neon integration tests when required.
# SPARROW_TEST_NEON=1
